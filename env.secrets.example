# App secrets — DO NOT commit this file.
# Copy to secrets/.env.secrets and fill in your values.

# --- Database ---
DB_TYPE=postgresql
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mydb
DB_USER=myuser
DB_PASSWORD=mypassword
DB_SCHEMA=public

# --- Flask ---
FLASK_SECRET_KEY=change-me-to-a-random-string

# --- Auth ---
# Leave SSO_ENABLED unset (or set to "false") for local dev (no login required)
# Set to "true" to enable real SAML SSO
SSO_ENABLED=false
STAGE=dev

# --- SAML (only needed when SSO_ENABLED=true) ---
SP_ENTITY_ID=my-app
# IDP_METADATA_URL, ACS_URL, SSO_HOST are configured in src/auth/saml_settings.py
